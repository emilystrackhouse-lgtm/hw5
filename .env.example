# Copy this file to .env (in the project root, hw5/) and fill in your own values.
# Never commit .env.

# Portkey API key used for every agent's AI calls.
PORTKEY_API_KEY=your-portkey-api-key-here

# Homework 5 requires gpt-6-luna for every agent (no other model allowed).
OPENAI_MODEL=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Working copy of the shop database used by the MCP server and backend.
DB_PATH=data/campus_customs_new.db

# Optional limits for one ticket run (all agents combined). Defaults shown.
# RUN_TOTAL_TOKENS_LIMIT=150000
# RUN_REQUEST_LIMIT=40
# RUN_TOOL_CALLS_LIMIT=60
# MAX_OUTPUT_TOKENS=1500
# MAX_DELEGATION_DEPTH=2
# MAX_DELEGATIONS_PER_RUN=10
